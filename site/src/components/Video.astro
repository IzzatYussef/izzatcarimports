---
// Video real da loja, sem som, em laco. Poster primeiro; nos horizontais (h-*),
// tela ate 1280 px baixa a versao 1280 (metade do peso).
interface Props { nome: string; class?: string; rotulo?: string; }
const { nome, class: cls, rotulo } = Astro.props;
const horizontal = nome.startsWith('h-');
---
<video class={cls} autoplay muted loop playsinline preload="metadata" poster={`/midia/${nome}.jpg`}
       aria-label={rotulo} aria-hidden={rotulo ? undefined : 'true'} data-video-loja>
  {horizontal && <source src={`/midia/${nome}-1280.webm`} type="video/webm" media="(max-width: 1280px)" />}
  {horizontal && <source src={`/midia/${nome}-1280.mp4`} type="video/mp4" media="(max-width: 1280px)" />}
  <source src={`/midia/${nome}.webm`} type="video/webm" />
  <source src={`/midia/${nome}.mp4`} type="video/mp4" />
</video>
<script>
  // quem pediu menos movimento ve o poster parado; fora da tela, pausa (economiza bateria)
  const vids = [...document.querySelectorAll<HTMLVideoElement>('video[data-video-loja]')];
  const parado = matchMedia('(prefers-reduced-motion: reduce)').matches;
  vids.forEach((v) => { if (parado) { v.removeAttribute('autoplay'); v.pause(); } });
  if (!parado && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement; if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { rootMargin: '200px' });
    vids.forEach((v) => io.observe(v));
  }
</script>
